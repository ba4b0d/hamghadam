# HamGhadam Production Environment Configuration Example
# Copy to .env in the deploy directory before running docker compose

APP_ENV=production
POSTGRES_USER=hamghadam
POSTGRES_PASSWORD=generate_a_secure_postgres_password_here
POSTGRES_DB=hamghadam_db

# Security secret key (generate with: openssl rand -hex 32)
SECRET_KEY=generate_a_secure_32_byte_hex_secret_here

# CORS configuration (allow Android app requests)
CORS_ORIGINS=*

# Logging level
LOG_LEVEL=INFO

# Firebase Cloud Messaging settings
FCM_DRY_RUN=false
# Service account file should be present at ../secrets/firebase-service-account.json
FCM_CREDENTIALS_PATH=/app/secrets/firebase-service-account.json
