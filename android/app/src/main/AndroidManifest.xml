<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Health Connect read permissions (declaration-only; actual grants happen
         through the Health Connect consent UI via PermissionController).
         v1 scope is STEPS ONLY: only READ_STEPS is requested/surfaced. Sleep and
         heart-rate will be declared and requested only when a feature (sleep/HR
         challenge) actually uses them. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <!-- Android 15+ (API 35+): enables background reads. Declared always; the
         consent UI only shows it on devices that support it. When not granted,
         the app falls back to foreground-only sync. -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Android 13+ (API 33+): required to show challenge push notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".FitnessApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.FitnessApp"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.FitnessApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep links: fitnessapp://challenges/{id}[/join?code=…|/leaderboard] (BE-C3) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="fitnessapp" android:host="challenges" />
            </intent-filter>
        </activity>

        <!-- FCM (BE-C3): receives challenge_started/ended/beat_you data pushes
             and re-registers refreshed tokens. Harmless when no Firebase
             project is configured (no messages arrive). -->
        <service
            android:name=".data.fcm.FcmMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Debug push simulator (tester path without Firebase):
             adb shell am broadcast -a com.fitnessapp.android.action.SIMULATE_PUSH
               with extras deep_link "fitnessapp://challenges/1/join?code=CODE"
               type challenge_started challenge_id 1 -->
        <receiver
            android:name=".data.fcm.DebugFcmSimulatorReceiver"
            android:exported="true" />

        <!-- Required by the Health Connect controller before it shows its consent UI. -->
        <activity
            android:name=".permissions.PermissionsRationaleActivity"
            android:exported="true"
            android:theme="@style/Theme.FitnessApp">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Android 14+ (enforced at API 36, per the SPIKE finding): apps must also
             expose a ViewPermissionUsage component, or the consent flow silently
             returns with nothing granted. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
