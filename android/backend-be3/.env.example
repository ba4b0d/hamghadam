# --- app ---
APP_ENV=dev
DATABASE_URL=postgresql+psycopg2://fitness:fitness@db:5432/fitness
SECRET_KEY=change-me-in-prod-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["*"]
LOG_LEVEL=INFO

# --- FCM push (BE-C3) ---
# Dry-run is the default: notifications are logged, never sent, and no
# delivery rows are written (safe for dev/CI). For real pushes set the path
# to a Firebase service-account JSON and fcm_dry_run=false.
FCM_CREDENTIALS_PATH=
FCM_DRY_RUN=true
